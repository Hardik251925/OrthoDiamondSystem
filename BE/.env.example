# ───────── Ortho Diamond backend environment ─────────
# Copy to BE/.env and fill in. Never commit .env.

# development | test | production
NODE_ENV=development
# Backend HTTP port (4100 so it can run next to Medical-Store on 4000; gateway :8100 proxies /api, /socket.io, /uploads here)
PORT=4100
# Host to bind. 0.0.0.0 = reachable from other devices on the same Wi-Fi.
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL connection (Postgres 16+; pg_trgm extension is created by the first migration)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ortho_diamond?schema=public
# Separate DB used by `npm test` (wiped by the tests)
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ortho_diamond_test?schema=public

# Redis 7 (BullMQ queues from Step 4). Backend still boots if Redis is down; /api/health reports it.
REDIS_URL=redis://localhost:6379

# Ollama (Diamond AI, Step 13). AI_PROVIDER = ollama | meta_llama_api
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Public base URL used in links (WhatsApp "Open" link, tracking links).
# Same-Wi-Fi testing: http://<PC-WiFi-IP>:8100   ngrok: https://<NGROK_DOMAIN>
PUBLIC_BASE_URL=http://localhost:8100
# Free static ngrok domain (only needed when exposing publicly)
NGROK_DOMAIN=
# Extra comma-separated CORS origins (PUBLIC_BASE_URL, localhost:3100 and localhost:5180 are always allowed)
CORS_EXTRA_ORIGINS=

# Auth secrets: long random strings (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_PEPPER=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# HMAC key for signed private upload URLs and public tracking tokens
URL_SIGNING_SECRET=CHANGE_ME
SIGNED_URL_TTL_SECONDS=600

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev only: also return the OTP in the API response (handy when testing from a phone). Forced off in production.
OTP_DEV_ECHO=true
# SMS provider for OTP: console (dev) | msg91 | ... (real adapters added in Step 4)
SMS_PROVIDER=console

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Routing / ETA (Step 5). Public demo server is for development only.
OSRM_URL=https://router.project-osrm.org

# WhatsApp Cloud API (Step 4)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NEW_ORDER=od_new_order

# Firebase Cloud Messaging (Step 4) — path to service-account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=

# Razorpay test mode (Step 9)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dispatch point for delivery routes (Ortho Diamond warehouse)
WAREHOUSE_LAT=22.7196
WAREHOUSE_LNG=75.8577
# Demo only: auto-move agents of DISPATCHED orders when no real GPS arrives
DEMO_SIMULATOR=false

# Doctor website base URL for tracking links (GitHub Pages: https://hardik251925.github.io/OrthoDiamondSystem). Defaults to PUBLIC_BASE_URL.
PUBLIC_WEB_URL=
